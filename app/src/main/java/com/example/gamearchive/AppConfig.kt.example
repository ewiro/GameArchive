package com.example.gamearchive

/**
 * 全局配置（模板）。
 *
 * 使用方式：复制本文件为 AppConfig.kt，填入你自己的凭证。
 * AppConfig.kt 已加入 .gitignore，不会被提交。
 */
object AppConfig {
    // Steam 数据代理地址（Cloudflare Worker）。末尾的斜杠不要省。
    // 如果你部署了自己的 Worker，改为你的地址。
    const val PROXY_URL = "https://api.steam-tracker-proxy.cyou/"

    // ── Bangumi OAuth 凭证 ──
    // 去 https://bgm.tv/dev/app 注册应用后填入
    const val BANGUMI_CLIENT_ID = "你的 client_id"
    const val BANGUMI_CLIENT_SECRET = "你的 client_secret"
    const val BANGUMI_REDIRECT_URI = "gamearchive://oauth/bangumi"
}
