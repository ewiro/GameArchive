<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== MIUIX 浅色主题 ===== -->
    <style name="Theme.SteamTracker" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 浅色背景，状态栏图标用深色 -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/miuix_bg_light</item>

        <!-- 强调色 -->
        <item name="colorPrimary">@color/miuix_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">#FFE3EDFF</item>
        <item name="colorOnPrimaryContainer">@color/miuix_blue</item>

        <!-- 表面层级：页面底=浅灰，卡片=白 -->
        <item name="android:colorBackground">@color/miuix_bg_light</item>
        <item name="colorSurface">@color/miuix_bg_light</item>
        <item name="colorOnSurface">@color/miuix_text_primary_light</item>
        <item name="colorOnSurfaceVariant">@color/miuix_text_secondary_light</item>
        <item name="colorSurfaceContainerLowest">@color/miuix_card_light</item>
        <item name="colorSurfaceContainerLow">@color/miuix_card_light</item>
        <item name="colorSurfaceContainer">@color/miuix_card_light</item>
        <item name="colorSurfaceContainerHigh">@color/miuix_card_light</item>
        <item name="colorSurfaceContainerHighest">@color/miuix_card_light_alt</item>

        <!-- 描边/分割线 -->
        <item name="colorOutline">@color/miuix_text_tertiary_light</item>
        <item name="colorOutlineVariant">@color/miuix_divider_light</item>

        <!-- 圆角组件外观 (MIUIX 大圆角) -->
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.Miuix.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Miuix.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Miuix.Large</item>

        <!-- 默认控件样式 -->
        <item name="materialButtonStyle">@style/Widget.Miuix.Button</item>
        <item name="materialSwitchStyle">@style/Widget.Miuix.Switch</item>
    </style>

    <!-- ===== 圆角定义 ===== -->
    <style name="ShapeAppearance.Miuix.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">10dp</item>
    </style>
    <style name="ShapeAppearance.Miuix.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeAppearance.Miuix.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">22dp</item>
    </style>

    <!-- ===== MIUIX 风格按钮：大圆角胶囊、无阴影 ===== -->
    <style name="Widget.Miuix.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="backgroundTint">@color/miuix_blue</item>
    </style>

    <!-- ===== MIUIX 风格开关 ===== -->
    <style name="Widget.Miuix.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/white</item>
        <item name="trackTint">@color/sel_switch_track</item>
    </style>

    <!-- ===== MIUIX 风格弱按钮 (浅蓝底蓝字，用于次级操作) ===== -->
    <style name="Widget.Miuix.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="backgroundTint">?attr/colorPrimaryContainer</item>
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
    </style>

    <!-- 底部导航超小字体 -->
    <style name="SmallBottomNavText" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

</resources>
