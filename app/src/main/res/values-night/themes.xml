<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== MIUIX 深色主题 ===== -->
    <style name="Theme.SteamTracker" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 深色背景，状态栏图标用浅色 -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/miuix_bg_dark</item>

        <!-- 强调色 (深色下略提亮以保证对比度) -->
        <item name="colorPrimary">@color/miuix_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">#FF1F3A5F</item>
        <item name="colorOnPrimaryContainer">#FFCCDDFF</item>

        <!-- 表面层级：页面底=近黑，卡片=深灰 -->
        <item name="android:colorBackground">@color/miuix_bg_dark</item>
        <item name="colorSurface">@color/miuix_bg_dark</item>
        <item name="colorOnSurface">@color/miuix_text_primary_dark</item>
        <item name="colorOnSurfaceVariant">@color/miuix_text_secondary_dark</item>
        <item name="colorSurfaceContainerLowest">@color/miuix_card_dark</item>
        <item name="colorSurfaceContainerLow">@color/miuix_card_dark</item>
        <item name="colorSurfaceContainer">@color/miuix_card_dark</item>
        <item name="colorSurfaceContainerHigh">@color/miuix_card_dark</item>
        <item name="colorSurfaceContainerHighest">@color/miuix_card_dark_alt</item>

        <!-- 描边/分割线 -->
        <item name="colorOutline">@color/miuix_text_tertiary_dark</item>
        <item name="colorOutlineVariant">@color/miuix_divider_dark</item>

        <!-- 圆角组件外观 -->
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.Miuix.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Miuix.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Miuix.Large</item>

        <!-- 默认控件样式 -->
        <item name="materialButtonStyle">@style/Widget.Miuix.Button.Dark</item>
        <item name="materialSwitchStyle">@style/Widget.Miuix.Switch</item>
    </style>

    <style name="Widget.Miuix.Button.Dark" parent="Widget.Miuix.Button">
        <item name="backgroundTint">@color/miuix_blue_dark</item>
    </style>

</resources>
